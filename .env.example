APP_NAME=DocuFlow
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
MAX_UPLOAD_MB=50
UPLOAD_TTL_MINUTES=30
INSPECTION_WORKERS=2
INSPECTION_QUEUE_SLOTS=2
OCR_INTRA_OP_THREADS=2

# Docker Compose settings (used for the single-origin frontend/API stack).
DOCUFLOW_FRONTEND_ORIGIN=http://localhost:8080
DOCUFLOW_HTTP_PORT=8080
DOCUFLOW_BIND_ADDRESS=127.0.0.1

# For an internal deployment, use APP_ENV=production, APP_HOST=0.0.0.0, and set
# DOCUFLOW_FRONTEND_ORIGIN to the exact HTTPS origin served by the company reverse proxy.
# DocuFlow does not implement application login; the IT team owns network access.
